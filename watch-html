<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Video - VIDTUBE</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:Roboto,Arial}
body{background:#0f0f0f;color:#fff}
header{height:56px;display:flex;align-items:center;padding:0 16px;position:sticky;top:0;background:#0f0f0f;z-index:100}
.logo{font-weight:900;font-size:20px;display:flex;align-items:center;gap:5px}
.logo i{width:30px;height:20px;background:red;border-radius:5px;display:flex;align-items:center;justify-content:center;font-size:12px}
.container{display:flex;flex-wrap:wrap;padding:16px;gap:24px;max-width:1754px;margin:auto}
.left{flex:1;min-width:300px}
.player{width:100%;aspect-ratio:16/9;background:#000;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:40px}
.title{font-size:20px;font-weight:700;margin:12px 0}
.channel-row{display:flex;align-items:center;justify-content:space-between;margin:12px 0}
.channel{display:flex;align-items:center;gap:12px}
.av{width:40px;height:40px;background:linear-gradient(45deg,red,orange);border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700}
.sub{padding:8px 16px;background:#fff;color:#000;border:none;border-radius:20px;font-weight:700;cursor:pointer}
.actions{display:flex;gap:8px}
.actions button{padding:8px 16px;background:#272727;border:none;color:#fff;border-radius:20px;cursor:pointer}
.desc{background:#272727;padding:12px;border-radius:12px;margin-top:12px;font-size:14px;color:#aaa}
.right{width:402px;min-width:300px}
.right h3{margin-bottom:12px}
.s-card{display:flex;gap:8px;margin-bottom:8px;cursor:pointer}
.s-thumb{width:168px;aspect-ratio:16/9;background:#222;border-radius:8px;flex-shrink:0}
.s-info{font-size:14px}
.s-info .sm{color:#aaa;font-size:12px;margin-top:4px}
</style>
</head>
<body>
<header>
<div class="logo"><i class="fa-solid fa-play"></i> VIDTUBE</div>
</header>
<div class="container">
<div class="left">
<div class="player" id="player">▶️</div>
<h1 class="title" id="vtitle">Gaon Ka Samosa Wala Ameer Ho Gaya - AI Desi Kahani</h1>
<div class="channel-row">
<div class="channel"><div class="av">V</div><div><div style="font-weight:700">VIDTUBE Stories ✓</div><div style="font-size:12px;color:#aaa">1.2M subscribers</div></div><button class="sub" onclick="this.innerText='Subscribed ✓'">Subscribe</button></div>
<div class="actions"><button><i class="fa-solid fa-thumbs-up"></i> 45K</button><button><i class="fa-solid fa-share"></i> Share</button></div>
</div>
<div class="desc" id="vdesc">1.2M views • 2 days ago • Ye AI se bani desi kahani hai. Like karo, Share karo! #desi #story #ai</div>
</div>
<div class="right">
<h3>Up Next</h3>
<div id="suggest"></div>
</div>
</div>
<script>
// Video title URL se lega
const params = new URLSearchParams(location.search);
const t = params.get('t');
if(t){ document.getElementById('vtitle').innerText = decodeURIComponent(t); document.getElementById('player').innerText = decodeURIComponent(t); document.getElementById('player').style.fontSize='20px'; }
// Suggested videos
const vids = ["Bhoot Aur Chai - Funny Story","Chai Wale Ka Pyar - 90s Love","Truck Driver Ki Dua","Billi Ka Badla - Comedy"];
document.getElementById('suggest').innerHTML = vids.map(v=>`<div class="s-card" onclick="location.href='watch.html?t=${encodeURIComponent(v)}'"><div class="s-thumb"></div><div class="s-info">${v}<div class="sm">500K views • 3 days ago</div></div></div>`).join('');
</script>
</body>
</html>
